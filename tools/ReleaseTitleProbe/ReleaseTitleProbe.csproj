    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tubifarry\Tubifarry.csproj" AdditionalProperties="CI=true;NuGetAudit=false;TreatWarningsAsErrors=false" />
    <ProjectReference Include="..\..\Submodules\Lidarr\src\NzbDrone.Common\Lidarr.Common.csproj" AdditionalProperties="CI=true;NuGetAudit=false;TreatWarningsAsErrors=false" />
    <ProjectReference Include="..\..\Submodules\Lidarr\src\NzbDrone.Core\Lidarr.Core.csproj" AdditionalProperties="CI=true;NuGetAudit=false;TreatWarningsAsErrors=false" />
  </ItemGroup>
</Project>
